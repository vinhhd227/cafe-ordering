# Copy this file to .env.prod and fill in real values.
# .env.prod is git-ignored and must NEVER be committed.
#
# Used by: ./deploy.sh  (docker compose --env-file .env.prod)

# ── Database ──────────────────────────────────────────────
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_NAME=cafe_ordering_prod

# ── JWT ───────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_use_at_least_32_characters_long_random_string

# ── Admin account ─────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME

# ── VAPID (Web Push Notifications) ───────────────────────
# Generate a fresh keypair: npx web-push generate-vapid-keys
# Changing the public key invalidates all existing browser push subscriptions.
VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key
# VAPID_SUBJECT=mailto:admin@cafe-ordering.com
