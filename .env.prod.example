# Copy this file to .env.prod and fill in real values.
# .env.prod is git-ignored and must NEVER be committed.
#
# Used by: ./deploy.sh  (docker compose --env-file .env.prod)

# ── Database ──────────────────────────────────────────────
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_NAME=cafe_ordering_prod

# ── JWT ───────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_use_at_least_32_characters_long_random_string

# ── Admin account ─────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME
