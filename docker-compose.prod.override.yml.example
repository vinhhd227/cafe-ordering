# Production secrets — copy this file to docker-compose.prod.override.yml and fill in real values.
# docker-compose.prod.override.yml is git-ignored and must NEVER be committed.
#
# Usage:
#   docker compose -f docker-compose.prod.yml -f docker-compose.prod.override.yml up -d

services:
  cafe-db:
    environment:
      POSTGRES_PASSWORD: change_me_strong_db_password

  api:
    environment:
      - ConnectionStrings__DefaultConnection=Host=cafe-db;Port=5432;Database=cafe_ordering_db;Username=admin;Password=change_me_strong_db_password
      - Jwt__Key=change_me_at_least_32_characters_long_secret_key
      - AdminAccount__Password=change_me_admin_panel_password
