# Copy this file to .env.uat and fill in real values.
# .env.uat is git-ignored and must NEVER be committed.
#
# Used by: ./uat.sh  (docker compose --env-file .env.uat)

# ── Database ──────────────────────────────────────────────
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_NAME=cafe_ordering_uat

# ── JWT ───────────────────────────────────────────────────
JWT_KEY=CHANGE_ME_use_at_least_32_characters_long_random_string

# ── Admin account ─────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME
