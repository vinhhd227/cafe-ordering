# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
#
# Docker Compose reads .env automatically for variable interpolation.

# ── Database ──────────────────────────────────────────────
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_NAME=cafe_ordering_db        # use cafe_ordering_prod on production

# ── JWT ───────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_use_at_least_32_characters_long_random_string

# ── Admin account (prod only) ─────────────────────────────
ADMIN_PASSWORD=CHANGE_ME

# ── Optional: Docker host / ports (dev only) ──────────────
# HOST_IP=192.168.1.x   # set if running on a remote dev machine
# API_PORT=8080
# NGINX_PORT=8081
