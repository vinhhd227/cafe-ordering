# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
#
# Docker Compose reads .env automatically for variable interpolation.

# ── Project namespace (IMPORTANT — keeps dev/prod isolated) ───
# Dev machine:    COMPOSE_PROJECT_NAME=cafe-dev
# Prod server:    COMPOSE_PROJECT_NAME=cafe-prod
COMPOSE_PROJECT_NAME=cafe-dev

# ── Database ──────────────────────────────────────────────
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_NAME=cafe_ordering_db        # use cafe_ordering_prod on production

# ── JWT ───────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_use_at_least_32_characters_long_random_string

# ── Admin account (prod only) ─────────────────────────────
ADMIN_PASSWORD=CHANGE_ME

# ── VAPID (Web Push Notifications) ───────────────────────
# For local dev: set Vapid__PublicKey / Vapid__PrivateKey in appsettings.Development.json (gitignored)
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key

# ── Optional: Docker host / ports (dev only) ──────────────
# HOST_IP=192.168.1.x   # set if running on a remote dev machine
# API_PORT=8080
# NGINX_PORT=8081
